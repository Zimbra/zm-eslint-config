{
  "name": "@zimbra/eslint-config",
  "version": "2.1.0",
  "type": "module",
  "description": "ESLint configuration for Zimbra javascript projects.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./typescript": "./src/typescript.js"
  },
  "scripts": {
    "lint": "eslint src --config eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then npm run lint && git commit -am $npm_package_version && git tag $npm_package_version && git push && git push --tags; fi",
    "prepare": "husky || true"
  },
  "engines": {
    "node": "^25.9.0",
    "npm": "^11.12.1"
  },
  "dependencies": {
    "@eslint/compat": "^1.0.0",
    "@eslint/js": "^9.37.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^10.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testcafe": "^0.2.1",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.39.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "eslint": "^9.39.3",
    "husky": "^9.1.7"
  }
}
