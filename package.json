{
  "name": "eslint-config-zimbra",
  "version": "1.0.0",
  "description": "ESLint configuration for Zimbra javascript projects",
  "main": "index.js",
  "module": "src/index.js",
  "files": [
    "index.js",
    "test-rules.js"
  ],
  "scripts": {
    "test": "npm run lint",
    "lint": "eslint src",
    "linted": "npm run -s build && eslint src",
    "build": "npm run clean && npm run buildMain && npm run buildTestRules",
    "clean": "rm -f index.js test-rules.js",
    "buildMain": "rollup -c rollup.config.js -f cjs -o $npm_package_main $npm_package_module",
    "buildTestRules": "rollup -c rollup.config.js -f cjs -o test-rules.js src/test-rules.js",
    "prepublishOnly": "npm run -s test && npm run -s build && git commit -am $npm_package_version && git tag $npm_package_version && git push && git push --tags",
    "release": "npm publish",
    "release-beta": "npm publish --tag beta"
  },
  "eslintConfig": {
    "extends": "./index.js"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@m6web/eslint-plugin-i18n": "^2.0.4",
    "@rollup/plugin-buble": "^1.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-mocha": "^10.2.0",
    "eslint-plugin-preact-i18n": "^1.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testcafe": "^0.2.0",
    "rollup": "^4.14.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testcafe": "^0.2.0",
    "eslint-plugin-mocha": "^10.2.0"
  },
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "author": "Damini Vashishtha <damini.vashishtha@synacor.com>",
  "license": "SEE LICENSE IN LICENSE"
}
